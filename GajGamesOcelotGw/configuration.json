{
  "ReRoutes": [
    {
      "DownstreamPathTemplate": "/api/v1/Images/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "gaj-imgs",
      "UpstreamPathTemplate": "/api/v1/Images/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST" ]

    }
  ],
  "GlobalConfiguration": {
    "ServiceDiscoveryProvider": {
      "Host": "consul",
      "Port": 8500,
      "Type": "Consul"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*"
 }
