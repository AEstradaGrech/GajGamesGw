{
  "ReRoutes": [
    {
      "DownstreamPathTemplate": "/api/v1/Images/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "gaj-imgs",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/api/v1/Images/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "SwaggerKey": "gaj-imgs"
    }
  ],
  "SwaggerEndPoints": [
    {
      "Key": "gaj-imgs", //used to pair with the ReRoute configuration
      "Config": [
        {
          "Name": "TPS IMGs", //displayed in the combobox.
          "Version": "v1",
          "Url": "http://gaj-imgs:5100/swagger/v1/swagger.json" //address for the microservice documentation
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "RequestIdKey": "OcRequestId",
    "AdministrationPath": "/administration"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*"
}
