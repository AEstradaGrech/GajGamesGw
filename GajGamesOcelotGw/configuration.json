{
  "ReRoutes": [
    {
      "DownstreamPathTemplate": "/api/v1/Images/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "gaj-imgs",
      "UpstreamPathTemplate": "/api/v1/Images/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "DELETE", "UPDATE", "OPTIONS" ], // No OPTIONS == CORS preflight req headers error
      "SwaggerKey": "gaj-imgs"
    },
    {
      "DownstreamPathTemplate": "/api/v1/Users/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "gaj-ids4",
      "UpstreamPathTemplate": "/api/v1/Users/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "DELETE", "UPDATE", "OPTIONS" ],
      "SwaggerKey": "gaj-ids4"
    },
    {
      "DownstreamPathTemplate": "/api/v1/Auth/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "gaj-ids4",
      "UpstreamPathTemplate": "/api/v1/Auth/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "OPTIONS" ],
      "SwaggerKey": "gaj-ids4"
    },
    {
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "gaj-ids4",
      "UpstreamPathTemplate": "/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "OPTIONS" ],
      "SwaggerKey": "gaj-ids4"
    },
    {
      "DownstreamPathTemplate": "/api/v1/rtr/Images/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "gaj-router",
      "UpstreamPathTemplate": "/api/v1/rtr/Images/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "DELETE", "UPDATE", "OPTIONS" ],
      "SwaggerKey": "gaj-router"
    },
    {
      "DownstreamPathTemplate": "/api/v1/rtr/Users/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "gaj-router",
      "UpstreamPathTemplate": "/api/v1/rtr/Users/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "DELETE", "UPDATE", "OPTIONS" ],
      "SwaggerKey": "gaj-router"
    },
    {
      "DownstreamPathTemplate": "/api/v1/rtr/Store/{everything}",
      "DownstreamScheme": "http",
      "ServiceName": "gaj-router",
      "UpstreamPathTemplate": "/api/v1/rtr/Store/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "DELETE", "UPDATE", "OPTIONS" ]
    }    
  ],  
  "GlobalConfiguration": {
    "ServiceDiscoveryProvider": {
      "Host": "consul",
      "Port": 8500,
      "Type": "Consul"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*"
}
